<Window x:Class="Fusion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Fusion.Controls"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Fusion"
        Width="820" Height="560"
        MinWidth="720" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BgDeepBrush}"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/fusion.ico"
        FontFamily="{DynamicResource UiFont}"
        Loaded="OnLoaded"
        Closing="OnClosing"
        StateChanged="OnStateChanged">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="42"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid>
    <tb:TaskbarIcon x:Name="TrayIcon"
                    ToolTipText="Fusion"
                    IconSource="pack://application:,,,/Assets/fusion.ico"
                    TrayMouseDoubleClick="OnTrayOpen"
                    Visibility="Visible">
      <tb:TaskbarIcon.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Ouvrir" Click="OnTrayOpen"/>
          <MenuItem Header="Recharger" Click="OnReloadClick"/>
          <MenuItem Header="Arrêter" Click="OnStopClick"/>
          <Separator/>
          <MenuItem Header="Quitter" Click="OnTrayQuit"/>
        </ContextMenu>
      </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>

    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Background="{DynamicResource BgDeepBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
          <DockPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" WindowChrome.IsHitTestVisibleInChrome="False">
              <Image Source="pack://application:,,,/Assets/fusion-logo.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="Fusion" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
              <Button Style="{DynamicResource CaptionButton}" Click="OnOpenSettings" ToolTip="Parametres" Width="40" Height="32">
                <Path Data="M6,1 L8,1 L8.6,3.2 L10.5,4 L12.2,3.2 L13.5,5 L12.2,6.5 L12.8,8.5 L10.8,9.2 L10,11 L8,11 L7.2,9.2 L5.2,8.5 L5.8,6.5 L4.5,5 L5.8,3.2 L7.4,4 Z M8,6.2 A1.8,1.8 0 1 0 8,9.8 A1.8,1.8 0 1 0 8,6.2 Z"
                      Stretch="Uniform" Width="14" Height="14"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Fill="Transparent"/>
              </Button>
              <Button Style="{DynamicResource CaptionButton}" Click="OnMinimize" ToolTip="Réduire">
                <Path Data="M 0 0.5 L 10 0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
              </Button>
              <Button x:Name="MaxButton" Style="{DynamicResource CaptionButton}" Click="OnMaximize" ToolTip="Agrandir">
                <Path x:Name="MaxIcon" Data="M 0 0 H 10 V 10 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent"/>
              </Button>
              <Button Style="{DynamicResource CloseCaptionButton}" Click="OnClose" ToolTip="Fermer" Foreground="{DynamicResource TextMutedBrush}">
                <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Left panel -->
          <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}" CornerRadius="14" Padding="14">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom">
                <Button Style="{DynamicResource GhostButton}" HorizontalAlignment="Stretch" Click="OnCopyInviteClick" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" Fill="Transparent"
                          Data="M4,2 H10 V8 H4 Z M2,4 H8 V12 H2 Z"/>
                    <TextBlock Text="Copier le lien d'invitation" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>

              <StackPanel>
                <TextBlock Text="STATUT" Style="{DynamicResource SectionLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                  <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FFE25555" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Effect>
                      <DropShadowEffect x:Name="StatusGlow" BlurRadius="8" ShadowDepth="0" Color="#FFE25555" Opacity="0.7"/>
                    </Ellipse.Effect>
                  </Ellipse>
                  <TextBlock x:Name="StatusLabel" Text="HORS LIGNE" Foreground="{DynamicResource AccentBrush}"
                             FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="TOKEN DISCORD" Style="{DynamicResource SectionLabel}"/>
                <controls:SecretField x:Name="TokenField" Placeholder="Token Discord" Margin="0,0,0,12"/>

                <TextBlock Text="CLÉ IA GEMINI · GRATUITE" Style="{DynamicResource SectionLabel}"/>
                <controls:SecretField x:Name="GeminiField" Placeholder="Clé Gemini" Margin="0,0,0,8"/>

                <TextBlock Text="Obtenir une clé gratuite" Style="{DynamicResource LinkText}"
                           Margin="0,0,0,16" MouseLeftButtonUp="OnOpenGeminiKeyLink"/>

                <Button Style="{DynamicResource PinkButton}" HorizontalAlignment="Stretch" Click="OnReloadClick" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"
                          Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                          Data="M2,6 A6,6 0 1 0 8,2 M8,2 L6,0 M8,2 L6,4"/>
                    <TextBlock Text="Recharger" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <Button Style="{DynamicResource PinkButton}" HorizontalAlignment="Stretch" Click="OnStopClick">
                  <StackPanel Orientation="Horizontal">
                    <Rectangle Width="10" Height="10" Fill="White" RadiusX="1.5" RadiusY="1.5" Margin="0,0,8,0"/>
                    <TextBlock Text="Arrêter" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Right panel -->
          <Border Grid.Column="2" Background="{DynamicResource BgPanelBrush}" CornerRadius="14" Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- Idées -->
              <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="IDÉES DISCORD" Style="{DynamicResource SectionLabel}"/>
                <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,10">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" Fill="Transparent"
                          Data="M2,3 H12 V11 H8 L5,14 V11 H2 Z"/>
                    <TextBlock Text="/idee · sujet · nombre (1-5)" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,12" Opacity="0.7"/>

              <!-- Envoyer -->
              <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="ENVOYER UN MESSAGE" Style="{DynamicResource SectionLabel}"/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0">
                    <ComboBox x:Name="GuildCombo" Style="{DynamicResource FusionComboBox}"
                              Tag="Serveur" SelectionChanged="OnGuildChanged"/>
                    <Path x:Name="GuildIcon" Width="12" Height="12" Stretch="Uniform"
                          Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" Fill="Transparent"
                          Data="M2,10 V4 H6 V2 H10 V4 H14 V10 H2 Z M4,10 V14 H8 V10 M8,10 V14 H12 V10"/>
                  </Grid>
                  <Grid Grid.Column="2">
                    <ComboBox x:Name="ChannelCombo" Style="{DynamicResource FusionComboBox}"
                              Tag="# Salon"/>
                    <TextBlock x:Name="ChannelIcon" Text="#" Margin="12,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                               FontWeight="SemiBold" IsHitTestVisible="False"/>
                  </Grid>
                </Grid>

                <Grid Margin="0,0,0,10">
                  <TextBox x:Name="MessageBox" Style="{DynamicResource FusionTextBox}"
                           Height="88" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           TextChanged="OnMessageTextChanged"/>
                  <StackPanel x:Name="MessagePlaceholder" Orientation="Horizontal"
                              Margin="14,12,0,0" IsHitTestVisible="False">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,2,8,0" VerticalAlignment="Top"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" Fill="Transparent"
                          Data="M2,3 H12 V11 H8 L5,14 V11 H2 Z"/>
                    <TextBlock Text="Écris ton message..." Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                  </StackPanel>
                </Grid>

                <Button Style="{DynamicResource PinkButton}" HorizontalAlignment="Right" Click="OnSendClick">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"
                          Stroke="White" StrokeThickness="1.4" Fill="Transparent"
                          Data="M1,6 L13,1 L9,13 L7,8 Z"/>
                    <TextBlock Text="Envoyer via Fusion" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>

              <Border Grid.Row="3" Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10" Opacity="0.7"/>

              <!-- Journal -->
              <DockPanel Grid.Row="4">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                  <TextBlock Text="JOURNAL" Style="{DynamicResource SectionLabel}" Margin="0"/>
                  <Button DockPanel.Dock="Right" Width="28" Height="24" Background="Transparent"
                          BorderThickness="0" Cursor="Hand" Click="OnCopyLogClick" ToolTip="Copier le journal"
                          HorizontalAlignment="Right">
                    <Path Width="12" Height="12" Stretch="Uniform"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" Fill="Transparent"
                          Data="M4,2 H10 V8 H4 Z M2,4 H8 V12 H2 Z"/>
                  </Button>
                </DockPanel>

                <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="4">
                  <ScrollViewer x:Name="LogScroll" Style="{DynamicResource FusionScrollViewer}"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                Focusable="False">
                    <ItemsControl x:Name="LogList" IsHitTestVisible="False" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="12" Margin="8,3" FontFamily="Consolas, Cascadia Mono, Segoe UI"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </DockPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
