<UserControl x:Class="Fusion.Controls.SecretField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="38">
  <Border x:Name="RootBorder" Background="{DynamicResource BgInputBrush}"
          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="36"/>
      </Grid.ColumnDefinitions>

      <PasswordBox x:Name="HiddenBox" Grid.Column="0"
                   Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   CaretBrush="{DynamicResource AccentBrush}"
                   FontFamily="{DynamicResource UiFont}" FontSize="13"
                   Padding="12,0" VerticalContentAlignment="Center"
                   PasswordChanged="OnPasswordChanged"/>

      <TextBox x:Name="VisibleBox" Grid.Column="0"
               Background="Transparent" BorderThickness="0"
               Foreground="{DynamicResource TextPrimaryBrush}"
               CaretBrush="{DynamicResource AccentBrush}"
               FontFamily="{DynamicResource UiFont}" FontSize="13"
               Padding="12,0" VerticalContentAlignment="Center"
               Visibility="Collapsed"
               TextAlignment="Center"
               TextChanged="OnVisibleTextChanged"/>

      <TextBlock x:Name="PlaceholderLabel"
                 Grid.Column="0"
                 Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Foreground="{DynamicResource TextMutedBrush}"
                 FontFamily="{DynamicResource UiFont}" FontSize="12"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <Button Grid.Column="1" Click="OnToggleVisibility"
              Background="Transparent" BorderThickness="0" Cursor="Hand"
              ToolTip="Afficher / masquer">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <Path x:Name="Eye" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                    Fill="Transparent" Stretch="Uniform" Width="16" Height="12"
                    Data="M1,6 C3,2 7,1 10,1 C13,1 17,2 19,6 C17,10 13,11 10,11 C7,11 3,10 1,6 Z M10,4.2 A1.8,1.8 0 1 0 10,7.8 A1.8,1.8 0 1 0 10,4.2 Z"/>
            </Border>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </Grid>
  </Border>
</UserControl>
