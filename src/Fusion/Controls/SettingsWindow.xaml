<Window x:Class="Fusion.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parametres" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Background="#FF151A22" BorderBrush="#FF2A3340" BorderThickness="1"
          CornerRadius="14" Padding="18" Margin="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
    </Border.Effect>
    <StackPanel>
      <DockPanel Margin="0,0,0,14">
        <TextBlock Text="Parametres" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Style="{DynamicResource CaptionButton}" Width="28" Height="28"
                Click="OnClose" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}">
          <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
        </Button>
      </DockPanel>

      <TextBlock Text="MISES A JOUR" Style="{DynamicResource SectionLabel}"/>
      <TextBlock x:Name="VersionLabel" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
      <Button x:Name="CheckUpdateButton" Content="Verifier les mises a jour"
              Style="{DynamicResource PinkButton}" HorizontalAlignment="Left"
              Click="OnCheckUpdates" Margin="0,0,0,8"/>
      <TextBlock x:Name="UpdateMessage" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

      <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Opacity="0.7" Margin="0,0,0,14"/>

      <TextBlock Text="AIDE" Style="{DynamicResource SectionLabel}"/>
      <TextBlock Text="GitHub" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
      <TextBlock x:Name="GitHubLink" Style="{DynamicResource LinkText}" Margin="0,0,0,10"
                 MouseLeftButtonUp="OnOpenGitHub"/>
      <TextBlock Text="Discord" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
      <DockPanel>
        <TextBlock x:Name="DiscordLabel" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="Copier" Style="{DynamicResource GhostButton}"
                Padding="10,6" Margin="8,0,0,0" Click="OnCopyDiscord"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
