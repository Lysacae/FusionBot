<Window x:Class="Fusion.Controls.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fusion" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Background="#FF151A22" BorderBrush="#FF2A3340" BorderThickness="1"
          CornerRadius="14" Padding="18" Margin="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
    </Border.Effect>
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TitleText" Text="Fusion" FontWeight="SemiBold" FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                 Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>
      <Button Content="OK" Style="{DynamicResource PinkButton}" HorizontalAlignment="Right"
              MinWidth="88" Click="OnOk"/>
    </StackPanel>
  </Border>
</Window>
