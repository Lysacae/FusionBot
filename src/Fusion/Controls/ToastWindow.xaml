<Window x:Class="Fusion.Controls.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fusion" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False">
  <Border x:Name="Root" Background="#EE151A22" BorderBrush="#FF2A3340" BorderThickness="1"
          CornerRadius="12" Padding="14" Margin="10" Opacity="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
    </Border.Effect>
    <StackPanel>
      <TextBlock Text="Fusion" FontWeight="SemiBold" FontSize="12"
                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
    </StackPanel>
  </Border>
</Window>
