<Window x:Class="Fusion.Controls.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise a jour" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Background="#FF151A22" BorderBrush="#FF2A3340" BorderThickness="1"
          CornerRadius="14" Padding="20" Margin="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
    </Border.Effect>
    <StackPanel>
      <TextBlock Text="Mise a jour disponible" FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
      <TextBlock x:Name="VersionText" TextWrapping="Wrap" FontSize="13"
                 Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
      <Border MaxHeight="160" Background="{DynamicResource BgInputBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
              CornerRadius="10" Padding="10" Margin="0,0,0,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource FusionScrollViewer}">
          <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}"/>
        </ScrollViewer>
      </Border>
      <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                 Margin="0,0,0,12" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="LaterButton" Content="Plus tard" Style="{DynamicResource GhostButton}"
                Margin="0,0,8,0" MinWidth="100" Click="OnLater"/>
        <Button x:Name="InstallButton" Content="Installer" Style="{DynamicResource PinkButton}"
                MinWidth="110" Click="OnInstall"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
